package config

Color :: [4]f32

color_scheme :: struct {
	bg:              Color,
	fg:              Color,
	bar_bg:          Color,
	bar_border:      Color,
	bar_text:        Color,
	bar_active_text: Color,
	bar_active_line: Color,
	cursor:          Color,
	cursor_solid:    Color,
	selection:       Color,
	mode_normal:     Color,
	mode_insert:     Color,
	mode_visual:     Color,
	mode_command:    Color,
	overlay_bg:      Color,
	popup_bg:        Color,
	popup_border:    Color,
	popup_sel:       Color,
	popup_text:      Color,
	popup_text_sel:  Color,
	gutter_fg:       Color,
	gutter_rel:      Color,
	syntax_comment:  Color,
	syntax_string:   Color,
	syntax_keyword:  Color,
	syntax_number:   Color,
}

config :: struct {
	ui_scale:            f32,
	colorscheme:         color_scheme,
	tab_size:            int,
	ignored_directories: []string,
	font_regular:        string,
	font_bold:           string,
	font_italic:         string,
	font_bold_italic:    string,
}

